# OpenAI — solo server-side (MAI nel client / MAI commitare .env reale)
OPENAI_API_KEY=sk-replace-with-your-key

# Modello default (allineato al client)
OPENAI_MODEL=gpt-5.5

# Server
PORT=8767
HOST=127.0.0.1

# Limiti
MAX_CV_TEXT_CHARS=120000
MAX_BODY_BYTES=524288
OPENAI_TIMEOUT_MS=90000

# CORS: origini ammesse (virgola). Vuoto = stessa origine / localhost
# CORS_ORIGINS=http://127.0.0.1:8767,http://localhost:8767
